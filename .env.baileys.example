# Copy to .env.baileys (gitignored) for docker compose / local bridge.
# Use the SAME DATABASE_URL and JWT_SECRET as production Vercel.

DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
JWT_SECRET=replace-with-same-secret-as-vercel

# Demo bakery that owns the linked WhatsApp number
BAILEYS_BAKER_ID=1
BAILEYS_ENABLED=1
BAILEYS_WORKER=1

# Optional shared secret — also set BAILEYS_BRIDGE_SECRET on Vercel
# BAILEYS_BRIDGE_SECRET=long-random-string

# Optional LLM for messy questions
# GROQ_API_KEY=
