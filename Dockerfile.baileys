# Always-on Baileys WhatsApp Web worker (not for Vercel serverless).
# Build from repo root:
#   docker build -f Dockerfile.baileys -t sweettooth-baileys .
#   docker run --env-file .env.baileys -p 8080:8080 sweettooth-baileys

FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@10.5.2 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY lib ./lib
COPY artifacts/api-server ./artifacts/api-server

RUN pnpm install --frozen-lockfile --filter @workspace/api-server... \
  && pnpm --filter @workspace/api-server run build

ENV NODE_ENV=production
ENV PORT=8080
ENV BAILEYS_ENABLED=1
ENV BAILEYS_WORKER=1
ENV BAILEYS_AUTH_DIR=/data/baileys-auth

RUN mkdir -p /data/baileys-auth
VOLUME ["/data/baileys-auth"]

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/api/baileys/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["pnpm", "--filter", "@workspace/api-server", "run", "start"]
