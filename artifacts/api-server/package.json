{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "vitest run",
    "test:agent-safety": "tsx ./scripts/agent-safety-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx ./src/seed.ts",
    "seed:enrich": "tsx ./src/seed-enrich.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.43",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.21",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "nodemailer": "^9.0.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
