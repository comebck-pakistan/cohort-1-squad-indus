{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/sweet-tooth run build",
  "outputDirectory": "artifacts/sweet-tooth/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://cohort-1-squad-indus-api-server-z3b.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
